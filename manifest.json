{
  "manifest_version": 3,
  "name": "Selection Stats",
  "version": "1.7.1",
  "description": "Affiche count, sum, average, min, max pour les nombres sélectionnés",
  "icons": {
    "16": "icons/on-16.png",
    "32": "icons/on-32.png",
    "48": "icons/on-48.png",
    "128": "icons/on-128.png"
  },
  "permissions": [
    "clipboardWrite",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Selection Stats — Actif",
    "default_icon": {
      "16": "icons/on-16.png",
      "32": "icons/on-32.png",
      "48": "icons/on-48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "settings.js",
        "parse.js",
        "stats.js",
        "content.js"
      ],
      "run_at": "document_end",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
